// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection, used by the app at runtime. On a serverless host every
  // function instance opens its own connection, which exhausts a plain
  // Postgres connection limit - so this points at a pooler (PgBouncer, or
  // Neon's pooled endpoint).
  url = env("DATABASE_URL")

  // Direct connection, used only by `prisma migrate`. Migrations take advisory
  // locks and run DDL, neither of which survives a transaction pooler.
  // Locally both variables can point at the same database.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  workspaces  Workspace[]       @relation("UserWorkspaces")
  memberships WorkspaceMember[]

  workspaceInvites WorkspaceInvite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  // Better Auth 1.7.0-1.7.2 scoped account identity by OIDC issuer and required
  // this column; 1.7.6 reverted that and no longer writes it. Kept nullable so
  // existing rows retain their value while new inserts succeed - a required
  // column the library never writes fails every insert.
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // The (issuer, accountId) uniqueness went away with the column's meaning.
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User    @relation("UserWorkspaces", fields: [ownerId], references: [id])

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  collections  Collection[]
  environments Environment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([name, ownerId])
  // Leading column of the unique above is `name`, so owner lookups need this.
  @@index([ownerId])
}

enum MEMBER_ROLE {
  ADMIN
  EDITOR
  VIEWER
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  expiresAt   DateTime?
  createdById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Postgres does not index foreign keys automatically; without these, a
  // workspace or user delete sequentially scans this table.
  @@index([workspaceId])
  @@index([createdById])
}

model WorkspaceMember {
  id   String      @id @default(cuid())
  role MEMBER_ROLE @default(ADMIN)

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, workspaceId])
  // The unique above leads with userId, so it cannot serve a lookup by
  // workspace alone (the member list) or the cascade delete of a workspace.
  @@index([workspaceId])
}

model Collection {
  id   String @id @default(cuid())
  name String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Self-relation so a collection can contain folders. A null parentId means a
  // root-level collection.
  parentId String?
  parent   Collection?  @relation("CollectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Collection[] @relation("CollectionTree")

  requests Request[]

  // Manual ordering among siblings.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Names are unique among siblings, not across the whole workspace.
  @@unique([name, workspaceId, parentId])
  @@index([workspaceId])
  @@index([parentId])
}

enum BODY_TYPE {
  NONE
  JSON
  TEXT
  XML
  FORM_DATA
  URL_ENCODED
  GRAPHQL
}

enum REST_METHOD {
  GET
  POST
  PUT
  PATCH
  DELETE
}

model Request {
  id         String      @id @default(cuid())
  name       String
  method     REST_METHOD @default(GET)
  url        String
  parameters Json?
  headers    Json?

  body     Json?
  /// A string for JSON/TEXT/XML/GRAPHQL, or [{ key, value, enabled }] for
  /// FORM_DATA / URL_ENCODED.
  bodyType BODY_TYPE @default(JSON)

  /// { type: "none" | "bearer" | "basic" | "apiKey", ... } - see src/lib/auth-schemes.ts
  auth Json?

  /// [{ id, source, comparator, target, enabled }] - see src/lib/assertions.ts
  tests Json?

  response Json?

  collectionId String
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  runs         RequestRun[]

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([collectionId])
}

model RequestRun {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  status      Int
  statusText  String?
  headers     Json?
  body        Json?
  durationMs  Int
  size        Int?
  /// "browser" | "proxy"
  via         String?
  /// Assertion outcomes for this run, when the request had tests.
  testResults Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // getRequestRuns filters on requestId and orders by createdAt desc. As a
  // composite index this answers both without a sort step, and it is the table
  // that grows fastest - one row per send.
  @@index([requestId, createdAt])
}

/// Workspace-scoped variable sets. `{{name}}` appearing in a URL, header, query
/// param, or body is substituted from the active environment before sending.
model Environment {
  id   String @id @default(cuid())
  name String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// [{ key, value, enabled, secret }]
  variables Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([name, workspaceId])
  @@index([workspaceId])
}
