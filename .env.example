# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env - it is gitignored.
# ---------------------------------------------------------------------------

# Postgres. The port matches docker-compose.yml, which maps 5433 -> 5432 so it
# does not collide with a Postgres already running on the host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"

NODE_ENV="development"

# --- Better Auth -----------------------------------------------------------
# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Used to build workspace invite links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OAuth providers -------------------------------------------------------
# GitHub:  https://github.com/settings/developers
#          Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google:  https://console.cloud.google.com/apis/credentials
#          Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI --------------------------------------------------------------------
# https://aistudio.google.com/apikey - powers request-name and JSON-body suggestions.
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Proxy mode ------------------------------------------------------------
# Lets proxy mode (/api/proxy) reach loopback and private addresses.
# Only enable when the server runs on the same trusted machine as the APIs you
# are testing. On a shared or public deployment this disables the SSRF guard
# and turns the proxy into an open gateway to that server's internal network.
# IMPULSE_ALLOW_PRIVATE_HOSTS="true"
